rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /materials/{file=**} {
      // الجميع (الطلاب والأساتذة) يمكنهم القراءة والتحميل
      allow read: if request.auth != null;
      
      // الأستاذ فقط يمكنه الرفع، التعديل، أو الحذف
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'professor';
    }
  }
}